{
  "name": "@pascal-app/pdf-vector-extract",
  "version": "0.1.0",
  "description": "Extract transformed vector line segments from PDF pages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun run build && bun test"
  },
  "dependencies": {
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "pdf",
    "vector",
    "line-segments",
    "floor-plan"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gbrfvieira/editor.git",
    "directory": "packages/pdf-vector-extract"
  },
  "license": "MIT"
}
